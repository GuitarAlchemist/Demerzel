# Build pins for ix-registry-check. The only place they are set.
#
# registry-check.yml (the gate) and registry-check-build.yml both read this
# file. The gate fails if the ix commit it checked out, or the rustc that
# built the checker, differs from these values. Bump IX_SHA together with
# Cargo.toml and Cargo.lock in this directory.
IX_SHA=73b78bf0d5eccf04e56973bde556ec01a8c342d2
RUST_TOOLCHAIN=1.98.0
