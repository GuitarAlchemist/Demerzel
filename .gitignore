# Local settings with secrets/tokens
.claude/settings.local.json

# Session digests — per-session cursor state captured by the /digest skill
# and the PreCompact/Stop hook fallbacks. README is tracked; contents are
# session-specific and may include in-flight model context.
state/digests/*
!state/digests/README.md

# /teach generated courses (personal, regenerable)
learning/

# Build artifacts and tooling output (regenerable, never committed)
node_modules/
__pycache__/
*.pyc
*.stackdump

# dev-process-overseer preflight report — transient, machine-specific (absolute
# paths + stale head), regenerated each preflight. Like state/digests/, this is
# the tracked-state exception, not canonical governance state.
state/governance/dev-process-overseer.json

# Local tooling / editor / per-session scratch (machine-specific, not repo content)
.claude-octopus/
.claude/*.local.md
.claude/scheduled_tasks.lock
.claude/session-intent.md
.claude/session-plan.md
.zed/
