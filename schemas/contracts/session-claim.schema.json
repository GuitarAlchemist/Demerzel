{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GuitarAlchemist/Demerzel/schemas/contracts/session-claim",
  "title": "Cross-Session Claim Ledger Row",
  "description": "One append-only ~/.agents/claims.jsonl row. Latest row for a (repo, lane) pair wins; this is advisory coordination, not a distributed lock.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "repo", "lane", "status", "session", "evidence"],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC event timestamp"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "lane": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": ["claimed", "done", "released", "in-progress"]
    },
    "session": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "evidence": {
      "type": ["string", "null"],
      "description": "Commit SHA, file path, task ID, or null"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  }
}
