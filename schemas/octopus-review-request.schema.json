{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "octopus-review-request.schema.json",
  "title": "Repo-scoped Octopus review request",
  "description": "Identity and required-provider contract for one exact Git diff review run.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "commit_range",
    "commit_fingerprint",
    "required_providers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "commit_range": {
      "type": "string",
      "minLength": 3
    },
    "commit_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "required_providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
