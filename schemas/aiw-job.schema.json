{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demerzel.guitaralchemist.com/schemas/aiw-job.schema.json",
  "title": "AI Workforce Job Specification",
  "description": "Normalized job spec for AI workforce dispatch and execution.",
  "type": "object",
  "required": [
    "job_id",
    "issue",
    "repo",
    "risk",
    "afk_eligible",
    "provider_candidates",
    "runner_requirement",
    "cost_tier",
    "sandbox",
    "allowed_paths",
    "test_commands",
    "outputs_required"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Unique identifier for the job run"
    },
    "issue": {
      "type": "integer",
      "description": "GitHub issue number acting as the task contract"
    },
    "repo": {
      "type": "string",
      "description": "Target repository (e.g., 'GuitarAlchemist/Demerzel')"
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Assessed risk level for the job"
    },
    "afk_eligible": {
      "type": "boolean",
      "description": "Whether this job can run completely unattended"
    },
    "provider_candidates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Allowed providers for this job",
      "minItems": 1
    },
    "runner_requirement": {
      "type": "object",
      "required": ["os", "needs_gpu", "needs_network", "needs_browser"],
      "properties": {
        "os": {
          "type": "string",
          "enum": ["windows", "wsl", "linux", "any"]
        },
        "needs_gpu": { "type": "boolean" },
        "needs_network": {
          "type": "string",
          "enum": ["none", "limited", "full"]
        },
        "needs_browser": { "type": "boolean" }
      }
    },
    "cost_tier": {
      "type": "string",
      "enum": ["free", "cheap", "paid", "manual-approval"],
      "description": "Cost authorization tier"
    },
    "sandbox": {
      "type": "string",
      "enum": ["podman", "windows-vm", "wsl-worktree", "cloud-vm", "none"],
      "description": "Required isolation mechanism"
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Directories and files the worker is allowed to modify"
    },
    "test_commands": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Commands to run for validation"
    },
    "outputs_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Expected outputs (e.g. branch_or_pr, test_log, summary)"
    }
  }
}
